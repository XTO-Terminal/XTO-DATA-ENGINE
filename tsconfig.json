{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"
  },
  "include": [
    "api/**/*.ts",
    "indexer/**/*.ts",
    "src/**/*.ts",
    "database/**/*.ts",
    "config/**/*.ts",
    "scripts/**/*.ts"
  ]
}
